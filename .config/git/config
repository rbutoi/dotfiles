# much of this comes from
# https://blog.gitbutler.com/how-git-core-devs-configure-git/

[include]
  path = ~/.config/git/config.local   # personal, untracked

## core behavior

[core]
  excludesfile = ~/.gitignore
  fsmonitor = true
  # untrackedCache = true
  # pager = delta  # breaks magit C-RET; https://github.com/dandavison/delta
[init]
  defaultBranch = main
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[help]
  autocorrect = prompt

## diffing and merging

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[merge]
  conflictstyle = zdiff3
[rerere]
  enabled = true
  autoupdate = true

## talking to remotes

[fetch]
  prune = true
  pruneTags = true
  all = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[pull]
  rebase = true

## committing and rewriting

[commit]
  verbose = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

## aliases and url short forms

[alias]
  root = rev-parse --show-toplevel
  # opt-in difftastic: as diff.external it breaks everything that parses unified diffs
  difft = -c diff.external='difft --display inline' diff
[url "git@github.com:"]
  insteadOf = @gh:
[url "https://github.com/"]
  insteadOf = gh://

## third-party tools

[delta]
  navigate = true    # use n and N to move between diff sections
  hyperlinks = true
  features = line-numbers decorations
[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
[delta "magit-delta"]
  # magit doesn't like line numbers: https://github.com/dandavison/magit-delta/issues/13
  line-numbers = false

[icdiff]                        # TODO: if used??
  options = --line-numbers
[filter "lfs"]                  # TODO: auto-added, needed?
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
[protocol "file"]               # TODO: needed?
  allow = always
